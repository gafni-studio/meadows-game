{
  "name": "meadows-game",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && tsc --noEmit -p studio && vitest run",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run check && vite build && node scripts/smoke.mjs",
    "shots": "node scripts/shots.mjs",
    "sheet:export": "node scripts/json-to-sheet.mjs",
    "sheet:import": "node scripts/export-sheet.mjs",
    "studio": "vite --config studio/vite.config.ts",
    "studio:build": "vite build --config studio/vite.config.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "^1.65.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.4",
    "xlsx": "^0.18.5"
  }
}
